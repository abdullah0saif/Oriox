# ─── Sentiment (optional) ───
CRYPTOPANIC_API_KEY=

# ─── Application ───
LOG_LEVEL=INFO
SCANNER_INTERVAL_SECONDS=300
MIN_SETUP_CONFIDENCE=65
MIN_RR_RATIO=2.0
